<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <!-- 1. Backup -->
        <TextView style="@style/Step" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/step_backup" />
        <Button android:id="@+id/btn_open" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/open_backup" />
        <TextView android:id="@+id/backup_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textIsSelectable="true" android:text="@string/no_backup" />
        <ProgressBar android:id="@+id/progress" style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
        <TextView android:id="@+id/progress_text" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- 2. List out -->
        <TextView style="@style/Step" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/step_list" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btn_copy" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/copy_list" />
            <Button android:id="@+id/btn_save_txt" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/save_list" />
        </LinearLayout>
        <EditText android:id="@+id/wanted" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/wanted_hint" android:inputType="textCapSentences|textMultiLine"
            android:importantForAutofill="no" android:maxLines="4" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btn_copy_ai" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/copy_ai" />
            <Button android:id="@+id/btn_share_ai" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/share_ai" />
        </LinearLayout>

        <!-- 3. Edit -->
        <TextView style="@style/Step" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/step_edit" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/edit_help" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btn_paste" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/paste" />
            <Button android:id="@+id/btn_open_txt" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/open_txt" />
            <Button android:id="@+id/btn_reset" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/reset" />
        </LinearLayout>
        <EditText android:id="@+id/editor" android:layout_width="match_parent" android:layout_height="340dp"
            android:gravity="top|start" android:fontFamily="monospace" android:textSize="12sp"
            android:inputType="textMultiLine|textNoSuggestions" android:importantForAutofill="no"
            android:scrollbars="vertical" android:hint="@string/editor_hint" />

        <!-- 4. Save -->
        <TextView style="@style/Step" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/step_save" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btn_check" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/check" />
            <Button android:id="@+id/btn_save_backup" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/save_backup" />
        </LinearLayout>
        <TextView android:id="@+id/result" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textIsSelectable="true" android:textStyle="bold" android:visibility="gone" android:paddingTop="8dp" />
        <TextView android:id="@+id/report" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@color/report_bg" android:fontFamily="monospace" android:textSize="12sp"
            android:padding="10dp" android:textIsSelectable="true" android:visibility="gone"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
